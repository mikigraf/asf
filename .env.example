# Local Compose defaults. Copy to .env and replace every REPLACE_ value.
# Do not use .env files as a production secret-delivery mechanism.

POSTGRES_IMAGE=postgres:17.6-bookworm
POSTGRES_USER=asf
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
POSTGRES_DB=asf
POSTGRES_PORT=5432

MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
MINIO_ROOT_USER=asf-local-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=asf-evidence
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.132.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

ASF_IMAGE=asf:local
ASF_PORT=8080
# asf-server loads and validates all required settings for both `migrate` and `all`.
# `migrate` permanently binds a provisioned database to this V1 tenant ID.
ASF_TENANT_ID=0198efb8-0000-7000-8000-000000000001
ASF_DATABASE_URL=postgresql://asf:REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD@127.0.0.1:5432/asf
# Compose health/proxy wiring expects the container-side port to remain 8080.
# Change ASF_PORT above to select a different host-side port.
ASF_BIND_ADDRESS=0.0.0.0:8080
ASF_ARTIFACT_ROOT=./var/artifacts
# Migration mode reads this variable directly; the image overrides it with /opt/asf/migrations.
ASF_MIGRATIONS_DIR=./migrations
ASF_SIGNING_KEY_ID=local-development-key
ASF_SIGNING_SEED_BASE64=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32
ASF_API_TOKENS_JSON=[{"token":"REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES","subject":"local-platform-admin","roles":["platform_admin"]}]
ASF_DATABASE_MAX_CONNECTIONS=20
ASF_WORKFLOW_POLL_MILLISECONDS=1000
# Must exceed the poll interval and be no greater than 86400 seconds.
ASF_WORKFLOW_LEASE_SECONDS=30
ASF_MAINTENANCE_MODE=false

# Optional controller-side, read-only GitHub observation. Leave both values
# unset to keep the observer disabled; setting either one requires the complete
# group. Use the REST API root for GitHub.com or GitHub Enterprise. The URL must
# be credential-free HTTPS, and the bearer token never enters Runmill evidence.
# ASF_GITHUB_API_BASE=https://api.github.com/
# ASF_GITHUB_BEARER_TOKEN=REPLACE_WITH_GITHUB_CONTROLLER_TOKEN

# Optional production Linear intake. Leave every ASF_LINEAR_* value unset to
# keep INTAKE_SYNC fail-closed; setting any one requires the complete group.
# ASF_LINEAR_AUTH_MODE=personal_api_key
# ASF_LINEAR_API_TOKEN=REPLACE_WITH_LINEAR_API_TOKEN
# ASF_LINEAR_TEAM_MAPPINGS_JSON=[{"team_id":"REPLACE_LINEAR_TEAM_ID","repository_id":"0198efb8-0000-7000-8000-000000000010","repository":"owner/repository","completed_state_id":"REPLACE_LINEAR_COMPLETED_STATE_ID"}]
# ASF_LINEAR_CORRELATION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# ASF_LINEAR_CONNECTOR_IDENTITY=linear:production-controller
# ASF_LINEAR_OPT_IN_LABEL=asf:autonomous
# ASF_LINEAR_PAGE_SIZE=100

# Optional production Runmill cancellation and worker-health control. Leave
# every ASF_RUNMILL_* value unset to keep both activities fail-closed; setting
# any one requires the complete group. ASF and Runmill must share the
# registry/socket UID, both files must retain Runmill's private modes, and the
# worker ID must already exist in this tenant's inventory.
# ASF_RUNMILL_REGISTRY_PATH=/run/user/1000/runmill/daemon.json
# ASF_RUNMILL_CONTROL_TIMEOUT_MILLISECONDS=5000
# ASF_RUNMILL_CONTROLLER_SUBJECT=asf:production-controller
# ASF_RUNMILL_CANCELLATION_GRACE_SECONDS=30
# ASF_RUNMILL_WORKER_ID=0198c8d2-77af-7000-8000-000000000001
RUST_LOG=info
